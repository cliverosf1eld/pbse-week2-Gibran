# Copy to .env.local (not committed), then restart: npx expo start --clear
# /courts needs a sign-in, which arrives in Session 9, so until then point the app
# at the mock: run `npm run mock:phone` in spec/.
# Use your laptop's LAN address (ipconfig), never localhost: on a phone, localhost
# is the phone itself.
EXPO_PUBLIC_API_BASE_URL=http://192.168.x.x:4010
