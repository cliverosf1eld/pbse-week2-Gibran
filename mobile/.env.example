# Copy to .env.local (not committed), then restart: npx expo start --clear
# Use addresses the phone can reach, never localhost: on a phone, localhost is the
# phone itself. Find your laptop's LAN address with ipconfig.

# Mock mode, no sign-in: run `npm run mock:phone` in spec/ and leave KEYCLOAK unset.
EXPO_PUBLIC_API_BASE_URL=http://192.168.x.x:4010

# Real service and real sign-in: use these two lines instead. The Keycloak address
# must match the issuer in the service's OIDC_ISSUER, or every token gets a 401.
# EXPO_PUBLIC_API_BASE_URL=https://pbse-week2.vercel.app/v1
# EXPO_PUBLIC_KEYCLOAK_URL=https://your-keycloak-address
