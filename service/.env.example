# Either set DATABASE_URL on its own (what hosted providers give you)...
DATABASE_URL=

# ...or these, for local development.
DB_USER=postgres
DB_HOST=localhost
DB_NAME=badminton_booking
DB_PORT=5432
DB_PASSWORD=

PORT=3000
OIDC_ISSUER=
OIDC_JWKS_URI=
OIDC_AUDIENCE=

# A.4 — the origins allowed to read this service's replies, comma separated.
# An origin is scheme + host + port, with no trailing slash. Listed
# explicitly; the incoming Origin header is never reflected back.
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://pbse-week2-web.vercel.app
